# ######################################################
# - MySQL settings
# ######################################################
#
# https://dev.mysql.com/doc/refman/8.0/en/docker-mysql-more-topics.html#docker-environment-variables
# MySQL 8.0 Reference Manual | Installing and Upgrading MySQL | Installing MySQL on Linux | Deploying MySQL on Linux
# with Docker | More Topics on Deploying MySQL Server with Docker | Docker Environment Variables
#
MYSQL_DATABASE=${MONAME:?unset or empty in the .env file}_test
MYSQL_INITDB_SKIP_TZINFO=false
MYSQL_PASSWORD=${MONAME:?unset or empty in the .env file}
MYSQL_ROOT_HOST=${MYSQL_NAME:?unset or empty in the .env file}
MYSQL_ROOT_PASSWORD=${MONAME:?unset or empty in the .env file}
MYSQL_USER=${MONAME:?unset or empty in the .env file}