# ######################################################
# Application wide settings
# ######################################################
MONAME=moname
REVISION=1.0.0.BUILD-SNAPSHOT

# ######################################################
# Container common settings
# ######################################################
NETWORK_DRIVER=bridge
RESTART_POLICY=no

# ######################################################
# - Keycloak container settings
# ######################################################
KEYCLOAK_COMMAND=start --import-realm --optimized --verbose
#KEYCLOAK_COMMAND=start --optimized --verbose
KEYCLOAK_DATABASE_VENDOR=mysql
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.1.2
KEYCLOAK_HEALTHCHECK=~/bin/kcadm.sh get https://$${KC_HOSTNAME}:8443/auth/realms/${MONAME:?unset or empty in the .env file}/.well-known/openid-configuration --fields token_endpoint --realm ${MONAME:?unset or empty in the .env file} --server https://$${KC_HOSTNAME}:8443 --trustpass $${KC_HTTPS_KEY_STORE_PASSWORD} --truststore $${KC_HTTPS_KEY_STORE_FILE}
KEYCLOAK_HTTP_MANAGEMENT_PORT=9000
KEYCLOAK_HTTPS_PORT=8443
KEYCLOAK_NAME=keycloak

# ######################################################
# - MySQL container settings
# ######################################################
MYSQL_COMMAND=mysqld --character-set-server=utf8mb4 --collation-server=utf8mb4_general_ci --init-connect="SET NAMES 'utf8mb4' COLLATE 'utf8mb4_general_ci'"
MYSQL_HEALTHCHECK=mysql --execute 'SHOW TABLES FROM moname_test;' --host=$${HOSTNAME} --password=$${MYSQL_PASSWORD} --user=$${MYSQL_USER}
MYSQL_IMAGE=mysql:9.2.0
MYSQL_NAME=mysql
MYSQL_PORT=3306

# ######################################################
# - Oracle container settings
# ######################################################
#ORACLE_COMMAND=
#ORACLE_HEALTHCHECK= # TODO
ORACLE_IMAGE=gvenzl/oracle-xe:21.3.0-slim-faststart
ORACLE_NAME=oracle
ORACLE_PORT=1521

# ######################################################
# - SQLServer container settings
# ######################################################
SQLSERVER_COMMAND=/home/mssql/initial-command.sh
#SQLSERVER_HEALTHCHECK= # TODO
SQLSERVER_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
SQLSERVER_NAME=sqlserver
SQLSERVER_PORT=1433