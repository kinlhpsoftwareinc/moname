<?xml version="1.0" encoding="UTF-8"?>

<!--
Shared logback configuration provided for import
-->

<included>
	<springProperty defaultValue=""
					name="ACTIVE_PROFILES"
					scope="context"
					source="spring.profiles.active"/>
	<conversionRule class="com.kinlhp.moname.commons.logging.logback.SpringProfilesActiveConverter"
					conversionWord="ACTIVE_PROFILES"/>
	<property name="CONSOLE_LOG_PATTERN"
			  value="${CONSOLE_LOG_PATTERN:-%clr(%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd'T'HH:mm:ss.SSSXXX}}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}){} %clr(${PID:-}){magenta} %clr(--- %esb(){APPLICATION_NAME}%esb{APPLICATION_GROUP}[%15.15t] ${LOG_CORRELATION_PATTERN:-}[%ACTIVE_PROFILES]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}}"/>
</included>
